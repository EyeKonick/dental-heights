---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import teamPlayful from '../../assets/images/team/team-playful.jpg';
import caseBefore from '../../assets/images/cases/braces-veneers-before.png';
import caseAfter from '../../assets/images/cases/braces-veneers-after.png';
import { site } from '../../data/site';
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__copy">
    <h1 id="hero-title">Reaching the <span class="peak">peak</span> of your confidence, one smile at a time.</h1>
    <p class="hero__lead">
      A dental clinic on {site.address.street}, {site.address.city}, for check-ups, cleaning and fillings (pasta), and for
      braces, implants, veneers and whitening.
    </p>
    <div class="hero__actions">
      <Button variant="book" />
      <Button variant="call" />
    </div>
    <a class="text-link hero__msg" href={site.messengerUrl} target="_blank" rel="noopener">
      <Icon name="messenger" /><span>Or message us on Messenger</span>
    </a>
    <address class="hero__addr">
      <Icon name="pin" />
      <span><b>{site.address.unit}, {site.address.building}</b><br />{site.address.street}, {site.address.city}</span>
    </address>
  </div>

  <div class="hero__stage">
    <div class="stack" aria-hidden="true"></div>
    <div class="panel">
      <div class="panel__media">
      <Image
        src={teamPlayful}
        alt="The Dental Heights team in white coats, laughing and posing with thumbs up and finger hearts"
        widths={[480, 720, 960, 1200, 1453]}
        sizes="(max-width: 1080px) 100vw, 55vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      </div>
    </div>
    <aside class="smiles" aria-labelledby="hero-smiles-title">
      <h2 id="hero-smiles-title">One patient, 2023 to 2025</h2>
      <div class="smiles__pair">
        <figure>
          <Image src={caseBefore} alt="Uneven front teeth before treatment, 2023" widths={[160, 320]} sizes="160px" format="webp" loading="eager" />
        </figure>
        <figure>
          <Image src={caseAfter} alt="The same patient's straight, even front teeth after braces and direct veneers, 2025" widths={[160, 320]} sizes="160px" format="webp" loading="eager" />
        </figure>
      </div>
      <a class="smiles__note" href="#smiles">Braces and direct veneers. See more results</a>
    </aside>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - 88px);
    padding-block: clamp(20px, 3vh, 36px) clamp(20px, 3vh, 32px);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-5); align-items: stretch;
  }
  .hero__copy { grid-column: 1 / span 5; display: flex; flex-direction: column; justify-content: center; padding: 12px 0 24px; }
  h1 { font-size: var(--text-hero); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; }
  .peak { color: var(--brand-deep); }
  .hero__lead { margin-top: 22px; font-size: var(--text-md); line-height: 1.55; color: var(--ink-soft); max-width: 38ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: 30px; }
  .hero__msg { margin-top: 18px; font-size: var(--text-nav); }
  .hero__addr {
    margin-top: 28px; padding-top: var(--space-5); border-top: 1px solid var(--line);
    display: flex; gap: 14px; align-items: flex-start; font-size: var(--text-nav); line-height: 1.5; color: var(--ink-soft);
  }
  .hero__addr :global(svg) { width: 22px; height: 22px; flex: none; color: var(--brand-deep); margin-top: 1px; }
  .hero__addr b { color: var(--ink); font-weight: 600; }

  /* the team on a white panel that their white backdrop melts into, over a tilted sky-blue card */
  .hero__stage { grid-column: 6 / span 7; position: relative; min-height: 540px; z-index: 0; isolation: isolate; }
  .panel {
    position: absolute; inset: 0 0 0 6%; background: var(--panel); border-radius: var(--radius-xl); overflow: hidden;
    box-shadow: var(--shadow-panel);
  }
  .panel::before {
    content: ''; position: absolute; inset: auto -10% -38% 30%; height: 70%;
    background: var(--brand-tint); border-radius: 50%; opacity: 0.7;
  }
  /* focal moment: the team photo settles slowly into place, like light coming up over the ridge.
     .panel__media is taller than the panel so the scroll drift below never shows an edge. */
  .panel__media { position: absolute; inset: -8% 0 0 0; }
  .panel :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 100%;
    transform-origin: 50% 100%;
    animation: settle 2.4s var(--ease-heavy) both;
  }
  /* a slow parallax drift as the page scrolls, where scroll-driven animations are supported */
  @supports (animation-timeline: scroll()) {
    .panel__media {
      animation: drift linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 100vh;
    }
  }

  /* the copy rises in reading order on load */
  .hero__copy > * { animation: rise 1.1s var(--ease-heavy) both; }
  .hero__copy > :nth-child(2) { animation-delay: 0.12s; }
  .hero__copy > :nth-child(3) { animation-delay: 0.24s; }
  .hero__copy > :nth-child(4) { animation-delay: 0.36s; }
  .hero__copy > :nth-child(5) { animation-delay: 0.48s; }
  .stack { position: absolute; inset: -14px 0 14px 3%; background: var(--brand); border-radius: var(--radius-xl); transform: rotate(-1.6deg); z-index: -1; }

  /* real smiles inset */
  .smiles {
    position: absolute; left: 0; bottom: 28px; width: min(330px, 52%); z-index: 2;
    animation: rise 1.3s 0.7s var(--ease-heavy) both;
    background: var(--panel); border-radius: var(--radius-lg); padding: 14px 14px 12px; box-shadow: var(--shadow-soft);
  }
  .smiles h2 { font: 600 var(--text-nav)/1.2 var(--font-display); margin: 2px 4px 10px; letter-spacing: 0; }
  .smiles__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  /* the smile photos are low resolution: they only ever drift up a few pixels, never scale */
  .smiles figure { margin: 0; transition: transform var(--dur-hover) var(--ease-heavy); }
  @media (hover: hover) and (pointer: fine) {
    .smiles:hover figure { transform: translateY(-3px); }
    .smiles:hover figure:last-child { transition-delay: 80ms; }
  }
  .smiles :global(img) { width: 100%; height: auto; border-radius: var(--radius-sm); }
  .smiles figcaption { font-size: var(--text-xs); line-height: 1.3; margin-top: 6px; color: var(--ink-soft); }
  .smiles figcaption b { display: block; color: var(--ink); font-weight: 600; }
  .smiles__note { display: block; font-size: var(--text-xs); font-weight: 500; color: var(--brand-deep); margin: 8px 4px 0; }
  .smiles__note:hover, .smiles__note:focus-visible { color: var(--ink); }

  @keyframes settle { from { opacity: 0; transform: scale(1.07); } to { opacity: 1; transform: none; } }
  @keyframes drift { from { transform: none; } to { transform: translate3d(0, 6%, 0); } }
  @keyframes rise { from { opacity: 0; transform: translate3d(0, 22px, 0); } to { opacity: 1; transform: none; } }

  @media (max-width: 1080px) {
    .hero { grid-template-columns: 1fr; row-gap: 28px; min-height: 0; }
    .hero__copy, .hero__stage { grid-column: 1; }
    .hero__stage { min-height: 520px; }
  }
  @media (max-width: 640px) {
    .hero__copy { padding: 0; }
    h1 { font-size: clamp(32px, 9vw, 40px); }
    .hero__actions :global(.btn) { width: 100%; }
    .hero__stage { min-height: 0; margin-top: 8px; }
    .panel { position: relative; inset: auto; aspect-ratio: 4 / 3.5; }
    .stack { inset: -8px 4px auto 4px; height: calc(100% - 140px); }
    .smiles { position: relative; left: auto; bottom: auto; width: auto; margin: -44px 12px 0; }
  }
</style>
