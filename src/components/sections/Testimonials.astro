---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import data from '../../data/testimonials.json';

// the review screenshots, shown exactly as the clinic supplied them
const files = import.meta.glob<ImageMetadata>('../../assets/images/testimonials/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const imageFor = (file: string) => {
  const hit = Object.entries(files).find(([path]) => path.endsWith(`/${file}`));
  if (!hit) throw new Error(`Testimonial image not found: ${file}`);
  return hit[1];
};
const reviews = data.reviews.map((r) => ({ ...r, src: imageFor(r.image) }));
const star = 'M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z';
---
<section class="reviews section" id="reviews" aria-labelledby="reviews-title">
  <div class="container reviews__top">
    <SectionHeading
      id="reviews-title"
      title="What our patients say"
      intro="Real five-star reviews from Dental Heights patients on Google."
    />
    <button class="reviews__pause" type="button" aria-pressed="false" hidden>
      <svg class="reviews__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
      <svg class="reviews__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
      <span>Pause reviews</span>
    </button>
  </div>

  <!-- Infinite carousel: the list of cards is drawn twice and the track slides by exactly one copy,
       so the loop is seamless. The second copy is hidden from screen readers and keyboard. -->
  <div class="marquee" data-reveal="fade" role="region" aria-label="Patient reviews">
    <div class="marquee__track" style={`--count: ${reviews.length}`}>
      {[0, 1].map((copy) => (
        <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {reviews.map((r) => (
            <li class="rcard lift">
              <div class="rcard__screen">
                <Image
                  src={r.src}
                  alt={copy === 0 ? `Google review by ${r.name}, 5 stars: “${r.text}”` : ''}
                  widths={[400, 760]}
                  sizes="(max-width: 640px) 300px, 380px"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <div class="rcard__foot">
                <span class="rcard__stars" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20"><path d={star} /></svg>)}
                </span>
                <span class="rcard__src">Google review</span>
              </div>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<script>
  const marquee = document.querySelector<HTMLElement>('.marquee');
  const btn = document.querySelector<HTMLButtonElement>('.reviews__pause');
  if (marquee && btn && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    btn.hidden = false;
    const label = btn.querySelector('span')!;
    btn.addEventListener('click', () => {
      const paused = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play reviews' : 'Pause reviews';
      marquee.classList.toggle('is-paused', paused);
    });
    // stop the loop while it is off screen, so it costs nothing when nobody is looking
    new IntersectionObserver(([e]) => marquee.classList.toggle('is-away', !e.isIntersecting)).observe(marquee);
  }
  // Load every review screenshot as the carousel approaches, so no card slides in blank
  // (cards far to the right would otherwise wait for lazy-loading).
  if (marquee) {
    const warm = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      marquee.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
      warm.disconnect();
    }, { rootMargin: '600px 0px' });
    warm.observe(marquee);
  }
</script>

<style>
  /* white section that melts out of the gallery's ice blue */
  .reviews { background: linear-gradient(to bottom, var(--ground) 0, var(--panel) clamp(140px, 16vw, 260px)); overflow: hidden; }
  .reviews__top { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-5); flex-wrap: wrap; margin-bottom: var(--space-7); }
  .reviews__top :global(.heading) { margin-bottom: 0; }

  .reviews__pause {
    display: inline-flex; align-items: center; gap: var(--space-2); height: 44px; padding: 0 18px 0 14px;
    border: 0; border-radius: var(--radius-pill); cursor: pointer;
    background: var(--ground); box-shadow: inset 0 0 0 1px var(--line);
    font: 500 var(--text-sm)/1 var(--font-display); color: var(--ink);
  }
  .reviews__pause[hidden] { display: none; }
  .reviews__pause svg { width: 18px; height: 18px; fill: var(--brand-deep); }
  .reviews__icon-play { display: none; }
  .reviews__pause[aria-pressed='true'] .reviews__icon-play { display: inline; }
  .reviews__pause[aria-pressed='true'] .reviews__icon-pause { display: none; }

  /* the carousel: soft fades at both edges so cards drift in and out rather than being cut */
  .marquee {
    --card-w: 380px; --gap: var(--space-5);
    overflow: hidden; padding-block: var(--space-3) var(--space-7);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .marquee__track {
    display: flex; width: max-content;
    animation: reviews-loop calc(var(--count) * 9s) linear infinite;  /* about 45px a second: slow and calm */
  }
  .marquee__group { display: flex; gap: var(--gap); padding-right: var(--gap); margin: 0; list-style: none; }
  @keyframes reviews-loop { to { transform: translate3d(-50%, 0, 0); } }

  /* pauses: on hover (mouse), while a card has keyboard focus, with the button, and off screen */
  .marquee:focus-within .marquee__track,
  .marquee.is-paused .marquee__track,
  .marquee.is-away .marquee__track { animation-play-state: paused; }
  @media (hover: hover) and (pointer: fine) {
    .marquee:hover .marquee__track { animation-play-state: paused; }
  }

  /* one review card: every screenshot sits in the same white screen, top-aligned, so all cards match */
  .rcard {
    flex: none; width: var(--card-w); display: flex; flex-direction: column;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 10px; box-shadow: var(--shadow-card);
  }
  .rcard__screen {
    aspect-ratio: 1290 / 867; border-radius: var(--radius-md); overflow: hidden;
    background: #fff; box-shadow: inset 0 0 0 1px var(--ground-alt);
  }
  .rcard__screen :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: center top; }
  .rcard__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: 12px 8px 4px; }
  .rcard__stars { display: inline-flex; gap: 2px; }
  .rcard__stars svg { width: 16px; height: 16px; fill: var(--sun-deep); }
  .rcard__src { font: 500 var(--text-xs)/1 var(--font-display); color: var(--ink-soft); }

  @media (max-width: 640px) {
    .marquee { --card-w: 300px; --gap: var(--space-3); }
    .marquee__track { animation-duration: calc(var(--count) * 7s); }
  }

  /* reduced motion: no loop; the cards become a row you can swipe or scroll */
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-mask-image: none; mask-image: none; padding-inline: var(--gutter); }
    .marquee__track { animation: none; }
    .marquee__group[aria-hidden='true'] { display: none; }
    .rcard { scroll-snap-align: start; }
  }
</style>
